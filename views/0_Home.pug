extends structure

block sidebar

block main
  div
    p
    h3= page 
    br
    h5 Distribution of "Strings Attached Ltd." publications exclusively by &nbsp;
    p
      a(href= "https://nymetmusic.com/product-category/solo-instruments/mark-knight-cadenzas-and-scales/",
      title= "NymetMusic.com" target= "_blank")
       img(src="images/images/nm-logo.jpg" title= "Nymet Music" width="80%")
    p 
      | All publications can be purchased from Nymet Music. Click the links.

    div
      table.home
        tr.home
        each item, index in json2
          td.home
            a(href="/"+page2+"/"+index title= item.title+ " "+ item.description)
              img(src="images/images/"+item.thumb width="100px")
            br
            br
            a(href= item.link title= "View or purchase \"" +item.title+"\" at NymetMusic.com" target="_blank").btn.btn-outline-success.btn-xs= "Purchase £"+item.price
            //- a(href="").btn.btn-outline-success.btn-xs= "£"+item.price

    br
    div
      table.home
        tr.home
        each item, index in json3
          td.home
