            br
            a(href= item.link title= "View or purchase \"" +item.title+"\" at NymetMusic.com" target="_blank").btn.btn-outline-success.btn-xs= "Purchase £"+item.price
            //btn.btn-outline-success.btn-xs= "£"+item.price
            //- a(href="").btn.btn-outline-success.btn-xs= "£"+item.price
    br

